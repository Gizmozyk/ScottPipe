<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="@dimen/video_item_search_padding"
    android:paddingTop="@dimen/video_item_search_padding"
    android:paddingRight="@dimen/video_item_search_padding">

    <org.schabi.newpipe.views.NewPipeEditText
        android:id="@+id/manualConnectHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="6dp"
        android:hint="@string/parent_mode_manual_host_hint"
        android:inputType="textUri"
        android:maxLines="1" />

    <org.schabi.newpipe.views.NewPipeEditText
        android:id="@+id/manualConnectPort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="6dp"
        android:hint="@string/parent_mode_manual_port_hint"
        android:inputType="number"
        android:maxLines="1"
        android:text="46821" />

    <org.schabi.newpipe.views.NewPipeEditText
        android:id="@+id/manualConnectCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="6dp"
        android:hint="@string/parent_mode_manual_code_hint"
        android:inputType="number"
        android:maxLines="1" />

</LinearLayout>
