<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingLeft="@dimen/video_item_search_padding"
    android:paddingTop="@dimen/video_item_search_padding"
    android:paddingRight="@dimen/video_item_search_padding">

    <ImageView
        android:id="@+id/pairingQrCode"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/kid_mode_pairing_qr_content_description" />

    <TextView
        android:id="@+id/pairingQrHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="@string/kid_mode_pairing_qr_hint" />

    <TextView
        android:id="@+id/pairingCodeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center" />

</LinearLayout>
